ANTHROPIC_API_KEY=
# Para usar a OpenAI, troque o provedor e preencha a chave abaixo.
# JUDO_CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# Os padrões OpenAI são gpt-6-luna. Para trocar os modelos:
# JUDO_CHAT_ANSWER_MODEL=gpt-6-luna
# JUDO_CHAT_GUARDRAIL_MODEL=gpt-6-luna
# Guardrail pela Decisions API (só OpenAI; mais rápido, devolve probabilidades):
# JUDO_CHAT_GUARDRAIL_API=decisions
# JUDO_CHAT_GUARDRAIL_FORA_THRESHOLD=0.5
# JUDO_CHAT_GUARDRAIL_HARM_THRESHOLD=0.5
# JUDO_CHAT_GUARDRAIL_INSTRUCTIONS_THRESHOLD=0.5
# Tempo mínimo do corpus no cache da OpenAI (12h ou 30m):
# JUDO_CHAT_OPENAI_CACHE_TTL=12h
# Opcionais (valores padrão em src/judo_chat/config.py)
# JUDO_CHAT_ANSWER_MODEL=claude-haiku-5-5
# JUDO_CHAT_ANSWER_EFFORT=low
# JUDO_CHAT_GUARDRAIL_MODEL=claude-haiku-5-5
# JUDO_CHAT_GUARDRAIL_EFFORT=low
# JUDO_CHAT_CACHE_TTL=1h
# Re-aquecimento do cache (src/judo_chat/keepalive.py):
# JUDO_CHAT_KEEPALIVE_ENABLED=true
# JUDO_CHAT_KEEPALIVE_INTERVAL_S=3300
# JUDO_CHAT_KEEPALIVE_WINDOW_START=07:00
# JUDO_CHAT_KEEPALIVE_WINDOW_END=23:00
# JUDO_CHAT_KEEPALIVE_TIMEZONE=America/Sao_Paulo
# Para usar o Sonnet 5.5 (20x o preço por token do Haiku 5.5):
# JUDO_CHAT_ANSWER_MODEL=claude-sonnet-5-5
# JUDO_CHAT_ANSWER_EFFORT=low
# JUDO_CHAT_USE_REFUSAL_FALLBACKS=true
