# Copie para /etc/judoka-api/env (root, modo 600). Lido pelo systemd (EnvironmentFile).
JUDO_CHAT_PROVIDER=openai
OPENAI_API_KEY=
JUDO_CHAT_GUARDRAIL_API=decisions
JUDO_CHAT_OPENAI_CACHE_TTL=12h
# A página fica só no GitHub Pages; a API não a serve.
JUDO_CHAT_SERVE_CHAT_PAGE=false
# Limites de perguntas (padrões em src/judo_chat/config.py):
# JUDO_CHAT_QUESTION_LIMIT_PER_IP_PER_MINUTE=8
# JUDO_CHAT_QUESTION_LIMIT_PER_IP_PER_DAY=80
# JUDO_CHAT_QUESTION_LIMIT_GLOBAL_PER_DAY=1000
